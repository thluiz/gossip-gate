GOSSIP_API_KEY=your-random-api-key-here
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Extra bots, one per line: TELEGRAM_BOT_TOKEN_<NAME>. A destination opts in with
# "bot": "<name>" in destinations.json, which never holds the token itself.
# Use one when the chat belongs to another bot — the bot that posts has to be a
# member of that chat, and adding the default bot everywhere widens what it sees.
#TELEGRAM_BOT_TOKEN_JACI=the-other-bot-token
# Destination used when a request sends no "target". Named destinations live in
# destinations.json; see destinations.example.json.
TELEGRAM_CHAT_ID=your-telegram-chat-id
GOSSIP_DESTINATIONS_PATH=
# Destination for the automatic hard-limit alert.
ALERT_TARGET=default
# Destinations reachable over the UNAUTHENTICATED /mcp endpoint (comma separated).
MCP_UNAUTH_TARGETS=default
RATE_SOFT_RPM=10
RATE_HARD_RPM=50
# Per-destination soft limit; keep under Telegram's ~20 messages/minute per chat.
RATE_PER_DEST_RPM=18
BATCH_WINDOW_MS=30000
PORT=8005
HOST=127.0.0.1
LOG_RETENTION_DAYS=30
LOG_MAX_MSG_LEN=500
BLOCK_ALERT_COOLDOWN_MIN=5
